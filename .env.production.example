# ==========================================
# JobTrackr - Production Environment Configuration (.env)
# ==========================================

# Docker Hub Namespace
DOCKERHUB_USERNAME=satyamk07

# Security & CORS
JWT_SECRET=your_64_character_hex_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here
ALLOWED_ORIGINS=https://jobtrackr.vercel.app
FRONTEND_URL=https://jobtrackr.vercel.app

# Google OAuth2 Credentials (for User & Gmail integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis (Upstash)
REDIS_URL=rediss://default:your_redis_token@your_redis_host:6379

# PostgreSQL Databases (Neon)
USER_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/jobtrackr_users?sslmode=require
USER_DB_USERNAME=your_neon_username
USER_DB_PASSWORD=your_neon_password

APP_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/jobtrackr_applications?sslmode=require
APP_DB_USERNAME=your_neon_username
APP_DB_PASSWORD=your_neon_password

INGESTION_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/jobtrackr_ingestion?sslmode=require
INGESTION_DB_USERNAME=your_neon_username
INGESTION_DB_PASSWORD=your_neon_password

# Kafka (Self-Hosted on OCI VM via Docker Compose)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=

# AI (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
INGESTION_SCHEDULER_ENABLED=true
